<Project Sdk="Microsoft.NET.Sdk">

  <!-- Логика без зависимости от Inventor: шаблоны имён, настройки, отчёты.
       Всё, что можно проверить юнит-тестами, живёт здесь. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>InvAuto.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="InvAuto.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Булевы операции над многоугольниками (законцовки, сходящиеся в угол): Clipper2, лицензия Boost, без зависимостей. -->
    <PackageReference Include="Clipper2" Version="2.0.0" />
  </ItemGroup>

</Project>
