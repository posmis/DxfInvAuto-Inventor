<!--
  Общая тема окон InvAuto: спокойная светлая палитра в духе Inventor, лента команд, таблицы.
  Все цвета — здесь, чтобы при необходимости добавить тёмную тему одним файлом.
  Подключение в окне:
    <ResourceDictionary Source="/InvAuto;component/Framework/Ui/Theme.xaml"/>
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <!-- Иконки (DrawingImage, ключи Icon.*) — генерируются из assets/icons/*.svg -->
        <ResourceDictionary Source="/InvAuto;component/Framework/Ui/Icons.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Палитра -->
    <SolidColorBrush x:Key="WindowBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="RibbonBrush" Color="#F3F4F6" />
    <SolidColorBrush x:Key="PanelHeaderBrush" Color="#F7F8F9" />
    <SolidColorBrush x:Key="BorderBrush" Color="#D6D9DD" />
    <SolidColorBrush x:Key="GridLineBrush" Color="#ECEEF0" />
    <SolidColorBrush x:Key="TextBrush" Color="#1F2328" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#6A737D" />
    <SolidColorBrush x:Key="AccentBrush" Color="#0696D7" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#0583BD" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#046E9F" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#C3C8CE" />
    <SolidColorBrush x:Key="SortedHeaderBrush" Color="#EDF4FA" />
    <SolidColorBrush x:Key="HoverBrush" Color="#E8F2FA" />
    <SolidColorBrush x:Key="HoverBorderBrush" Color="#BFDCF2" />
    <SolidColorBrush x:Key="PressedBrush" Color="#CFE6F7" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#D7EBFA" />
    <SolidColorBrush x:Key="OkBrush" Color="#2E7D32" />
    <SolidColorBrush x:Key="WarningBrush" Color="#B26A00" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#C62828" />

    <!-- Цвета превью развертки -->
    <SolidColorBrush x:Key="FlatProfileBrush" Color="#2B2F33" />
    <SolidColorBrush x:Key="FlatBendBrush" Color="#0696D7" />
    <SolidColorBrush x:Key="FlatAuxBrush" Color="#A0A6AD" />

    <!-- Мелкие служебные значки (стрелки дерева, лупа) — системный шрифт Windows 10/11 -->
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <Style x:Key="IconText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <Style x:Key="MutedText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
    </Style>

    <!-- Тексты форм: одинаковые во всех окнах -->
    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <!-- Заголовок раздела внутри формы — с отступом сверху от предыдущего раздела -->
    <Style x:Key="FormSection" TargetType="TextBlock" BasedOn="{StaticResource SectionTitle}">
        <Setter Property="Margin" Value="0,16,0,6" />
    </Style>

    <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Margin" Value="0,3,0,0" />
    </Style>

    <!-- ===== Лента команд ===== -->

    <Style x:Key="RibbonBar" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource RibbonBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="4,4,4,2" />
    </Style>

    <!-- Группа команд: содержимое сверху, подпись снизу, разделитель справа -->
    <Style x:Key="RibbonGroup" TargetType="HeaderedContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="HeaderedContentControl">
                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Margin="0,2" Padding="4,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ContentPresenter VerticalAlignment="Top" />
                            <ContentPresenter Grid.Row="1" ContentSource="Header" HorizontalAlignment="Center" Margin="0,2,0,0"
                                              TextElement.Foreground="{StaticResource MutedTextBrush}" TextElement.FontSize="11" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Большая кнопка: иконка 32×32 над текстом. Иконка задаётся через Tag="{StaticResource Icon.Имя}". -->
    <Style x:Key="RibbonButton" TargetType="ButtonBase">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="MinWidth" Value="58" />
        <Setter Property="MaxWidth" Value="88" />
        <Setter Property="Height" Value="74" />
        <Setter Property="Margin" Value="1,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="2" Padding="4,4,4,2">
                        <StackPanel>
                            <Image Source="{TemplateBinding Tag}" Width="32" Height="32" Margin="0,0,0,3"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                            <ContentPresenter HorizontalAlignment="Center" TextBlock.TextAlignment="Center">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap" />
                                        <Setter Property="LineHeight" Value="13" />
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource HoverBorderBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource PressedBrush}" />
                        </Trigger>
                        <Trigger Property="ToggleButton.IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource PressedBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource HoverBorderBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Основная команда окна (ключ оставлен, чтобы её можно было выделить отдельно) -->
    <Style x:Key="RibbonPrimaryButton" TargetType="ButtonBase" BasedOn="{StaticResource RibbonButton}" />

    <!-- Маленькая кнопка: иконка слева от текста, для вертикальных столбиков команд -->
    <Style x:Key="RibbonSmallButton" TargetType="ButtonBase">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Margin" Value="1,0,1,1" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="2" Padding="4,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{TemplateBinding Tag}" Width="16" Height="16" Margin="0,0,6,0" />
                            <ContentPresenter VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource HoverBorderBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource PressedBrush}" />
                        </Trigger>
                        <Trigger Property="ToggleButton.IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource PressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Панели ===== -->

    <!-- Заголовок панели. Одна высота у всех панелей окна, даже если в одной из них есть поле или кнопки. -->
    <Style x:Key="PanelHeader" TargetType="Border">
        <Setter Property="MinHeight" Value="35" />
        <Setter Property="Background" Value="{StaticResource PanelHeaderBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="8,5" />
    </Style>

    <Style x:Key="PanelTitle" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Splitter" TargetType="GridSplitter">
        <Setter Property="Width" Value="5" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Background" Value="{StaticResource RibbonBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1,0" />
    </Style>

    <Style x:Key="StatusBar" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource RibbonBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Padding" Value="8,3" />
    </Style>

    <!-- ===== Таблицы (неявные стили — применяются ко всем DataGrid окна) ===== -->

    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="{StaticResource WindowBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource GridLineBrush}" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="CanUserResizeRows" Value="False" />
        <Setter Property="CanUserReorderColumns" Value="True" />
        <Setter Property="SelectionUnit" Value="FullRow" />
        <Setter Property="RowBackground" Value="{StaticResource WindowBrush}" />
        <Setter Property="AlternatingRowBackground" Value="{StaticResource WindowBrush}" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        <Setter Property="EnableRowVirtualization" Value="True" />
    </Style>

    <!-- Захват границы колонки для изменения ширины -->
    <Style x:Key="HeaderGripper" TargetType="Thumb">
        <Setter Property="Width" Value="8" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="SizeWE" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="{TemplateBinding Background}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      Заголовок колонки. Колонка, по которой отсортирован список, выделена фоном и полужирным текстом,
      справа от названия — стрелка направления, как в проводнике: вверх — по возрастанию, вниз — по убыванию.
    -->
    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource PanelHeaderBrush}" />
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,1,1" />
        <Setter Property="Padding" Value="6,5" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <Grid>
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="False"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}">
                                    <ContentPresenter.Resources>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        </Style>
                                    </ContentPresenter.Resources>
                                </ContentPresenter>
                                <TextBlock x:Name="SortArrow" Grid.Column="1" Style="{StaticResource IconText}" FontSize="10"
                                           Margin="5,1,0,0" Foreground="{StaticResource AccentBrush}" Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <Thumb x:Name="PART_LeftHeaderGripper" HorizontalAlignment="Left" Margin="-4,0,0,0" Style="{StaticResource HeaderGripper}" />
                        <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right" Margin="0,0,-4,0" Style="{StaticResource HeaderGripper}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- Подсветка при наведении — только у колонок, по которым можно сортировать -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="CanUserSort" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}" />
                        </MultiTrigger>
                        <Trigger Property="SortDirection" Value="Ascending">
                            <Setter TargetName="SortArrow" Property="Text" Value="&#xE70E;" />
                            <Setter TargetName="SortArrow" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SortedHeaderBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="SortDirection" Value="Descending">
                            <Setter TargetName="SortArrow" Property="Text" Value="&#xE70D;" />
                            <Setter TargetName="SortArrow" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SortedHeaderBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsPressed" Value="True" />
                                <Condition Property="CanUserSort" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource PressedBrush}" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DataGridRow">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource HoverBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource SelectionBrush}" />
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===== Формы ===== -->

    <!-- Поля ввода и списки — одной высоты с кнопками -->
    <Style TargetType="TextBox">
        <Setter Property="Padding" Value="3,2" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="BorderBrush" Value="{StaticResource ControlBorderBrush}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- ===== Кнопки =====
      Все кнопки окон — плоские, в одной гамме с лентой:
        FlatButton   — основа: белая кнопка с рамкой; кнопка по умолчанию (IsDefault, «ОК») — синяя;
        DialogButton — кнопка диалога (ОК, Отмена, Обзор…), одинаковой ширины;
        DangerButton — необратимое действие (удалить, очистить, сбросить) — красный текст;
        ToolButton   — кнопка панели инструментов: прозрачная, иконка 16 px через Tag и/или текст;
        LinkButton   — действие внутри панели в виде ссылки («Копировать», «×»).
      Кнопки без явного стиля получают FlatButton (неявный стиль ниже).
    -->
    <Style x:Key="FlatButton" TargetType="ButtonBase">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Background" Value="{StaticResource WindowBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ControlBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Height" Value="26" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource HoverBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource HoverBorderBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource PressedBrush}" />
            </Trigger>
            <Trigger Property="ToggleButton.IsChecked" Value="True">
                <Setter Property="Background" Value="{StaticResource PressedBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource HoverBorderBrush}" />
            </Trigger>
            <!-- Кнопка по умолчанию (Enter) — синяя, как в Windows 11 -->
            <Trigger Property="Button.IsDefault" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                <Setter Property="Foreground" Value="White" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Button.IsDefault" Value="True" />
                    <Condition Property="IsMouseOver" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{StaticResource AccentHoverBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource AccentHoverBrush}" />
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Button.IsDefault" Value="True" />
                    <Condition Property="IsPressed" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{StaticResource AccentPressedBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource AccentPressedBrush}" />
            </MultiTrigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="Button" BasedOn="{StaticResource FlatButton}" />

    <Style x:Key="DialogButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
        <Setter Property="MinWidth" Value="88" />
        <Setter Property="Margin" Value="6,0,0,0" />
    </Style>

    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource DialogButton}">
        <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
    </Style>

    <Style x:Key="ToolButton" TargetType="ButtonBase">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Height" Value="28" />
        <Setter Property="MinWidth" Value="28" />
        <Setter Property="Margin" Value="1,0" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="2" Padding="{TemplateBinding Padding}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Image x:Name="Icon" Source="{TemplateBinding Tag}" Width="16" Height="16" VerticalAlignment="Center" />
                            <ContentPresenter x:Name="Text" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="{x:Null}">
                            <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Text" Property="Margin" Value="0" />
                        </Trigger>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="Text" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource HoverBorderBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource PressedBrush}" />
                        </Trigger>
                        <Trigger Property="ToggleButton.IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource PressedBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource HoverBorderBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Вертикальный разделитель групп на панели инструментов -->
    <Style x:Key="ToolSeparator" TargetType="Border">
        <Setter Property="Width" Value="1" />
        <Setter Property="Margin" Value="6,4" />
        <Setter Property="Background" Value="{StaticResource BorderBrush}" />
    </Style>

    <Style x:Key="LinkButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter x:Name="Text" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Text" Property="TextElement.Foreground" Value="{StaticResource AccentHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
