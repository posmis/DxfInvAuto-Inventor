<Window x:Class="InvAuto.Features.Service.AppSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки InvAuto"
        Width="780" Height="520" MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBrush}"
        FontFamily="Segoe UI" FontSize="12"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/InvAuto;component/Framework/Ui/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="PageTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,0,0,4" />
            </Style>
            <Style x:Key="Section" TargetType="TextBlock">
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,16,0,6" />
            </Style>
            <Style x:Key="Label" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="0,3,12,3" />
            </Style>
            <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Margin" Value="0,3,0,0" />
            </Style>
            <Style x:Key="PathBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                <Setter Property="IsReadOnly" Value="True" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0,3" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="DaysBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                <Setter Property="Width" Value="56" />
                <Setter Property="Height" Value="24" />
                <Setter Property="HorizontalContentAlignment" Value="Right" />
                <Setter Property="Margin" Value="6,0" />
            </Style>
            <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource DialogButton}">
                <Setter Property="Margin" Value="0,0,8,0" />
                <Setter Property="Padding" Value="10,0" />
            </Style>
            <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
                <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
            </Style>
            <Style x:Key="NavItem" TargetType="ListBoxItem">
                <Setter Property="Padding" Value="12,7" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Bd" Background="Transparent" BorderThickness="3,0,0,0" BorderBrush="Transparent"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource SelectionBrush}" />
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Style="{StaticResource StatusBar}" Padding="12,8">
            <DockPanel>
                <TextBlock Style="{StaticResource MutedText}" VerticalAlignment="Center"
                           Text="Очистка и сброс выполняются сразу, после подтверждения. Сроки хранения — по кнопке ОК." />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource DialogButton}" IsDefault="True" Click="OnOk">ОК</Button>
                    <Button Style="{StaticResource DialogButton}" IsCancel="True">Отмена</Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Разделы -->
        <Border DockPanel.Dock="Left" Width="190" Background="{StaticResource RibbonBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <ListBox x:Name="NavList" Background="Transparent" BorderThickness="0" Margin="0,8,0,0"
                     ItemContainerStyle="{StaticResource NavItem}" SelectionChanged="OnSectionChanged">
                <ListBoxItem Tag="CachePage">Кэш разверток</ListBoxItem>
                <ListBoxItem Tag="LogPage">Журнал</ListBoxItem>
                <ListBoxItem Tag="ResetPage">Сброс настроек</ListBoxItem>
                <ListBoxItem Tag="AboutPage">О программе</ListBoxItem>
            </ListBox>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Margin="20,16,20,16">

                <!-- ============ Кэш разверток ============ -->
                <StackPanel x:Name="CachePage">
                    <TextBlock Text="Кэш разверток" Style="{StaticResource PageTitle}" />
                    <TextBlock Style="{StaticResource Hint}">
                        DXF, сформированные кнопкой «Сформировать развертки», хранятся здесь, чтобы окно «Листовые детали»
                        показывало их сразу. Файлы деталей и выгруженные DXF в кэше не хранятся и очисткой не затрагиваются.
                    </TextBlock>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Папка" Style="{StaticResource Label}" />
                        <TextBox x:Name="CacheFolderText" Grid.Column="1" Style="{StaticResource PathBox}" />
                        <TextBlock Grid.Row="1" Text="Занято" Style="{StaticResource Label}" />
                        <TextBlock x:Name="CacheSizeText" Grid.Row="1" Grid.Column="1" Style="{StaticResource Label}" Text="подсчёт…" />
                    </Grid>

                    <TextBlock Text="Автоматическая очистка" Style="{StaticResource Section}" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Удалять развертки, не использовавшиеся дольше" VerticalAlignment="Center" />
                        <TextBox x:Name="CacheDaysBox" Style="{StaticResource DaysBox}" />
                        <TextBlock Text="дней" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Hint}" Text="Проверяется при каждом открытии окна «Листовые детали». От 1 до 3650 дней." />

                    <TextBlock Text="Действия" Style="{StaticResource Section}" />
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource ActionButton}" Click="OnOpenCacheFolder">Открыть папку</Button>
                        <Button x:Name="ClearCacheButton" Style="{StaticResource DangerButton}" Click="OnClearCache">Очистить кэш…</Button>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Hint}">
                        Перед удалением будет показан полный список файлов. Удаляются только файлы *.dxf внутри папки кэша;
                        ссылки на другие папки не обходятся.
                    </TextBlock>
                </StackPanel>

                <!-- ============ Журнал ============ -->
                <StackPanel x:Name="LogPage" Visibility="Collapsed">
                    <TextBlock Text="Журнал" Style="{StaticResource PageTitle}" />
                    <TextBlock Style="{StaticResource Hint}">
                        Журнал работы InvAuto: один файл на день. Нужен для поиска причин ошибок — приложите его к сообщению о проблеме.
                    </TextBlock>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Папка" Style="{StaticResource Label}" />
                        <TextBox x:Name="LogFolderText" Grid.Column="1" Style="{StaticResource PathBox}" />
                        <TextBlock Grid.Row="1" Text="Занято" Style="{StaticResource Label}" />
                        <TextBlock x:Name="LogSizeText" Grid.Row="1" Grid.Column="1" Style="{StaticResource Label}" Text="подсчёт…" />
                    </Grid>

                    <TextBlock Text="Автоматическая очистка" Style="{StaticResource Section}" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Удалять файлы журнала старше" VerticalAlignment="Center" />
                        <TextBox x:Name="LogDaysBox" Style="{StaticResource DaysBox}" />
                        <TextBlock Text="дней" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Hint}" Text="Проверяется при запуске Inventor. От 1 до 3650 дней." />

                    <TextBlock Text="Действия" Style="{StaticResource Section}" />
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource ActionButton}" Click="OnOpenLogFolder">Открыть папку</Button>
                        <Button Style="{StaticResource ActionButton}" Click="OnOpenCurrentLog">Открыть сегодняшний</Button>
                        <Button Style="{StaticResource DangerButton}" Click="OnClearLog">Очистить журнал…</Button>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Hint}">
                        Удаляются только файлы *.log; сегодняшний файл, в который идёт запись, сохраняется.
                    </TextBlock>
                </StackPanel>

                <!-- ============ Сброс настроек ============ -->
                <StackPanel x:Name="ResetPage" Visibility="Collapsed">
                    <TextBlock Text="Сброс настроек" Style="{StaticResource PageTitle}" />
                    <TextBlock Style="{StaticResource Hint}">
                        Возвращает значения по умолчанию. Текущий файл настроек не удаляется, а переносится в папку backup
                        с датой и временем — его можно вернуть вручную.
                    </TextBlock>

                    <Grid x:Name="ResetGrid" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                    </Grid>

                    <TextBlock Text="Папка настроек" Style="{StaticResource Section}" />
                    <TextBox x:Name="SettingsFolderText" Style="{StaticResource PathBox}" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Style="{StaticResource ActionButton}" Click="OnOpenSettingsFolder">Открыть папку</Button>
                    </StackPanel>
                </StackPanel>

                <!-- ============ О программе ============ -->
                <StackPanel x:Name="AboutPage" Visibility="Collapsed">
                    <TextBlock Text="О программе" Style="{StaticResource PageTitle}" />
                    <Grid x:Name="AboutGrid" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                    </Grid>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
