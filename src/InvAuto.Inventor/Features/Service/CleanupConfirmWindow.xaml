<Window x:Class="InvAuto.Features.Service.CleanupConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Подтверждение удаления"
        Width="760" Height="560" MinWidth="560" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBrush}"
        FontFamily="Segoe UI" FontSize="12"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/InvAuto;component/Framework/Ui/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="FontSize" Value="11" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel>
        <!-- Кнопки -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource StatusBar}" Padding="12,8">
            <DockPanel>
                <Button DockPanel.Dock="Left" Style="{StaticResource DialogButton}" Margin="0" Click="OnCopy"
                        ToolTip="Скопировать список файлов в буфер обмена">Копировать список</Button>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="DeleteButton" Style="{StaticResource DialogButton}" MinWidth="140" IsEnabled="False" Click="OnDelete" />
                    <Button x:Name="CloseButton" Style="{StaticResource DialogButton}" IsCancel="True">Отмена</Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Предупреждение -->
        <Border DockPanel.Dock="Top" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,12">
            <DockPanel>
                <Border x:Name="WarningMark" DockPanel.Dock="Left" Width="28" Height="28" CornerRadius="14" Margin="0,0,12,0"
                        Background="{StaticResource WarningBrush}" VerticalAlignment="Top">
                    <TextBlock Text="!" Foreground="White" FontWeight="Bold" FontSize="16"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel>
                    <TextBlock x:Name="HeadlineText" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="FolderText" Style="{StaticResource Hint}" Margin="0,4,0,0" />
                    <TextBlock x:Name="ConsequenceText" TextWrapping="Wrap" Margin="0,6,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Подтверждение -->
        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,10">
            <StackPanel>
                <TextBlock x:Name="SkippedTitle" FontWeight="SemiBold" Margin="0,0,0,4" Visibility="Collapsed" />
                <ListBox x:Name="SkippedList" MaxHeight="90" Margin="0,0,0,10" Visibility="Collapsed"
                         BorderBrush="{StaticResource BorderBrush}" />
                <CheckBox x:Name="ConfirmBox" Checked="OnConfirmChanged" Unchecked="OnConfirmChanged">
                    Я просмотрел список и понимаю, что эти файлы будут удалены без возможности восстановления
                </CheckBox>
                <TextBlock x:Name="ResultText" TextWrapping="Wrap" FontWeight="SemiBold" Visibility="Collapsed" />
            </StackPanel>
        </Border>

        <!-- Список файлов -->
        <DataGrid x:Name="FilesGrid" Margin="16,10,16,10" AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" SelectionMode="Extended"
                  CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False"
                  BorderBrush="{StaticResource BorderBrush}" HorizontalGridLinesBrush="{StaticResource GridLineBrush}"
                  RowHeight="22" VirtualizingPanel.IsVirtualizing="True" EnableRowVirtualization="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Файл" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="Размер" Binding="{Binding Size}" Width="90" SortMemberPath="Length" />
                <DataGridTextColumn Header="Изменён" Binding="{Binding Modified}" Width="130" SortMemberPath="Time" />
                <DataGridTextColumn x:Name="StateColumn" Header="Итог" Binding="{Binding State}" Width="200" Visibility="Collapsed" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
