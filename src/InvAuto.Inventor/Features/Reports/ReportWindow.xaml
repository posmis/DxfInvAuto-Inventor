<Window x:Class="InvAuto.Features.Reports.ReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ведомость листовых деталей"
        Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBrush}"
        FontFamily="Segoe UI" FontSize="12"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/InvAuto;component/Framework/Ui/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="Label" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="0,0,12,0" />
            </Style>
            <Style TargetType="CheckBox">
                <Setter Property="Margin" Value="0,3" />
            </Style>
            <Style TargetType="RadioButton">
                <Setter Property="Margin" Value="0,3" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Style="{StaticResource StatusBar}" Padding="12,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource DialogButton}" IsDefault="True" Click="OnOk">Сохранить…</Button>
                    <Button Style="{StaticResource DialogButton}" IsCancel="True">Отмена</Button>
                </StackPanel>
                <TextBlock x:Name="ErrorText" Foreground="{StaticResource ErrorBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
            </DockPanel>
        </Border>

        <StackPanel Margin="16,4,16,14">
            <TextBlock Text="Шапка" Style="{StaticResource FormSection}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="Название" Style="{StaticResource Label}" />
                <TextBox x:Name="TitleBox" Grid.Column="1" />

                <TextBlock Grid.Row="1" Text="Изделие" Style="{StaticResource Label}" Margin="0,6,12,0" />
                <TextBox x:Name="ProductBox" Grid.Row="1" Grid.Column="1" Margin="0,6,0,0" />

                <TextBlock Grid.Row="2" Text="Дата" Style="{StaticResource Label}" Margin="0,6,12,0" />
                <DatePicker x:Name="DateBox" Grid.Row="2" Grid.Column="1" Margin="0,6,0,0" Width="160" HorizontalAlignment="Left" />
            </Grid>
            <TextBlock Style="{StaticResource Hint}"
                       Text="Название и дата печатаются вверху каждого листа, номер листа — внизу. Пустое название — «Ведомость листовых деталей»." />

            <TextBlock Text="Детали" Style="{StaticResource FormSection}" />
            <RadioButton x:Name="CheckedOnly" GroupName="Scope" />
            <RadioButton x:Name="AllRows" GroupName="Scope" />
            <CheckBox x:Name="FlatsBox">Картинки разверток в таблице деталей</CheckBox>
            <TextBlock Style="{StaticResource Hint}"
                       Text="Развертки, которые ещё не сформированы, будут сформированы перед отчётом: без них нет площади, массы и длины реза." />

            <TextBlock Text="Формат" Style="{StaticResource FormSection}" />
            <CheckBox x:Name="ExcelBox">Excel (.xlsx) — листы «Сводка» и «Детали», итоги формулами, фильтр</CheckBox>
            <CheckBox x:Name="PdfBox">PDF — листы A4 с шапкой и нумерацией</CheckBox>
            <CheckBox x:Name="OpenBox" Margin="0,10,0,3">Открыть после сохранения</CheckBox>
        </StackPanel>
    </DockPanel>
</Window>
