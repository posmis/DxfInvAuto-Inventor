<Window x:Class="InvAuto.Features.SheetMetal.BendSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:InvAuto.Features.SheetMetal"
        Title="Линии гиба"
        Width="860" Height="520" MinWidth="760" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBrush}"
        FontFamily="Segoe UI" FontSize="12"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/InvAuto;component/Framework/Ui/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="Number" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                <Setter Property="Width" Value="80" />
                <Setter Property="Height" Value="24" />
                <Setter Property="HorizontalContentAlignment" Value="Right" />
                <Setter Property="HorizontalAlignment" Value="Left" />
            </Style>
            <Style x:Key="SectionTitle" TargetType="TextBlock">
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="Margin" Value="0,0,0,10" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel>
        <!-- Кнопки -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource StatusBar}" Padding="12,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource DialogButton}" IsDefault="True" Click="OnOk">ОК</Button>
                    <Button Style="{StaticResource DialogButton}" IsCancel="True">Отмена</Button>
                </StackPanel>
                <TextBlock x:Name="ErrorText" Foreground="{StaticResource ErrorBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
            </DockPanel>
        </Border>

        <!-- Заголовок: кого касается -->
        <Border DockPanel.Dock="Top" Style="{StaticResource PanelHeader}" Padding="16,10">
            <StackPanel>
                <TextBlock x:Name="ScopeTitle" FontWeight="SemiBold" FontSize="13" />
                <TextBlock x:Name="ScopeText" Style="{StaticResource MutedText}" Margin="0,2,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ===== Параметры ===== -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16,14,16,14" Grid.IsSharedSizeScope="True">
                    <CheckBox x:Name="UseDefaultBox" Margin="0,0,0,14" Checked="OnChanged" Unchecked="OnChanged" />

                    <StackPanel x:Name="OptionsPanel">
                        <TextBlock Text="Параметры" Style="{StaticResource SectionTitle}" />
                        <local:BendOptionsEditor x:Name="Editor" Changed="OnEditorChanged" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Column="1" Width="1" Background="{StaticResource BorderBrush}" />

            <!-- ===== Расчёт ===== -->
            <DockPanel Grid.Column="2" Margin="16,14,16,10">
                <TextBlock DockPanel.Dock="Top" Text="Расчёт" Style="{StaticResource SectionTitle}" />
                <TextBlock x:Name="SampleTitle" DockPanel.Dock="Top" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,8" />
                <StackPanel x:Name="SampleLengthPanel" DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Длина линии для примера" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBox x:Name="SampleLengthBox" Style="{StaticResource Number}" Text="200" TextChanged="OnChanged" />
                    <TextBlock Text="мм" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="6,0,0,0" />
                </StackPanel>

                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="{StaticResource WindowBrush}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="LayoutList" Margin="10,6">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource GridLineBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding Title}" FontWeight="SemiBold" Margin="0,0,10,0" />
                                                <TextBlock Text="{Binding Layout.Description}" Style="{StaticResource MutedText}"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Layout.Description}" />
                                            </DockPanel>
                                            <local:BendLineBar Layout="{Binding Layout}" Margin="0,6,0,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
