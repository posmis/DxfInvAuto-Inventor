<Window x:Class="InvAuto.Features.SheetMetal.BendSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:InvAuto.Features.SheetMetal"
        Title="Линии гиба"
        Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBrush}"
        FontFamily="Segoe UI" FontSize="12"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/InvAuto;component/Framework/Ui/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="Section" TargetType="TextBlock">
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,14,0,6" />
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            </Style>
            <Style x:Key="Label" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="0,0,10,0" />
            </Style>
            <Style x:Key="Number" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                <Setter Property="Width" Value="64" />
                <Setter Property="Height" Value="24" />
                <Setter Property="HorizontalContentAlignment" Value="Right" />
            </Style>
            <Style TargetType="RadioButton">
                <Setter Property="Margin" Value="0,3" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Style="{StaticResource StatusBar}" Padding="12,8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource DialogButton}" IsDefault="True" Click="OnOk">ОК</Button>
                <Button Style="{StaticResource DialogButton}" IsCancel="True">Отмена</Button>
            </StackPanel>
        </Border>

        <StackPanel Margin="16,8,16,14">
            <TextBlock x:Name="ScopeText" TextWrapping="Wrap" Style="{StaticResource MutedText}" />

            <CheckBox x:Name="UseDefaultBox" Margin="0,10,0,0" Checked="OnChanged" Unchecked="OnChanged" />

            <StackPanel x:Name="OptionsPanel">
                <TextBlock Text="Что сделать с линиями гиба" Style="{StaticResource Section}" />
                <!-- Способы заполняются из BendLineStrategies.All -->
                <ComboBox x:Name="ModeBox" Width="300" Height="24" HorizontalAlignment="Left"
                          DisplayMemberPath="Title" SelectionChanged="OnChanged" />

                <!-- Параметры: прямоугольные вырезы -->
                <Grid x:Name="SlotsPanel" Margin="20,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Смещение в каждую сторону" Style="{StaticResource Label}" />
                    <TextBox x:Name="SlotOffsetBox" Grid.Column="1" Style="{StaticResource Number}" TextChanged="OnChanged" />
                    <TextBlock x:Name="SlotWidthText" Grid.Column="2" Style="{StaticResource Label}" Margin="6,0,0,0" />

                    <TextBlock Grid.Row="1" Text="Расположение" Style="{StaticResource Label}" Margin="0,8,10,0" />
                    <ComboBox x:Name="SlotPatternBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Width="260" Height="24"
                              HorizontalAlignment="Left" Margin="0,8,0,0" SelectionChanged="OnChanged" />
                </Grid>

                <!-- Параметры: прорези по краям -->
                <StackPanel x:Name="EdgeCutsPanel" Orientation="Horizontal" Margin="20,8,0,0">
                    <TextBlock Text="Длина прорези у каждого края" Style="{StaticResource Label}" />
                    <TextBox x:Name="EdgeCutBox" Style="{StaticResource Number}" TextChanged="OnChanged" />
                    <TextBlock Text="мм" Style="{StaticResource Label}" Margin="6,0,0,0" />
                </StackPanel>

                <!-- Параметры: прерывистая линия -->
                <Grid x:Name="DashedPanel" Margin="20,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Длина прорези" Style="{StaticResource Label}" />
                    <TextBox x:Name="DashBox" Grid.Column="1" Style="{StaticResource Number}" TextChanged="OnChanged" />
                    <TextBlock Grid.Column="2" Text="мм" Style="{StaticResource Label}" Margin="6,0,0,0" />

                    <TextBlock Grid.Row="1" Text="Длина перемычки" Style="{StaticResource Label}" Margin="0,6,10,0" />
                    <TextBox x:Name="BridgeBox" Grid.Row="1" Grid.Column="1" Style="{StaticResource Number}" Margin="0,6,0,0" TextChanged="OnChanged" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="мм" Style="{StaticResource Label}" Margin="6,6,0,0" />

                    <TextBlock Grid.Row="2" Text="У краёв" Style="{StaticResource Label}" Margin="0,8,10,0" />
                    <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,8,0,0">
                        <RadioButton x:Name="EndsCut" GroupName="Ends" Content="прорезь" Margin="0,0,16,0" Checked="OnChanged" />
                        <RadioButton x:Name="EndsBridge" GroupName="Ends" Content="перемычка" Checked="OnChanged" />
                    </StackPanel>

                    <TextBlock Grid.Row="3" Text="Подгонка под длину" Style="{StaticResource Label}" Margin="0,8,10,0" />
                    <ComboBox x:Name="FitBox" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Width="260" Height="24"
                              HorizontalAlignment="Left" Margin="0,8,0,0" SelectionChanged="OnChanged" />
                </Grid>
            </StackPanel>

            <!-- Расчёт -->
            <TextBlock Text="Расчёт" Style="{StaticResource Section}" />
            <TextBlock x:Name="SampleTitle" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,6" />
            <StackPanel x:Name="SampleLengthPanel" Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="Пример: линия длиной" Style="{StaticResource Label}" />
                <TextBox x:Name="SampleLengthBox" Style="{StaticResource Number}" Text="200" TextChanged="OnChanged" />
                <TextBlock Text="мм" Style="{StaticResource Label}" Margin="6,0,0,0" />
            </StackPanel>
            <ItemsControl x:Name="LayoutList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,4">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Text="{Binding Title}" FontWeight="SemiBold" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding Layout.Description}" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                            <local:BendLineBar Layout="{Binding Layout}" Margin="0,4,0,0" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="ErrorText" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
        </StackPanel>
    </DockPanel>
</Window>
