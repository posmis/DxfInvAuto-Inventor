<Window x:Class="InvAuto.Features.SheetMetal.BendSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:InvAuto.Features.SheetMetal"
        Title="Линии гиба"
        Width="860" Height="520" MinWidth="760" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBrush}"
        FontFamily="Segoe UI" FontSize="12"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/InvAuto;component/Framework/Ui/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Строка формы: подпись слева (общая ширина для всех строк), поле, единица измерения -->
            <Style x:Key="FieldLabel" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            </Style>
            <Style x:Key="Unit" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="6,0,0,0" />
            </Style>
            <Style x:Key="Field" TargetType="Grid">
                <Setter Property="Margin" Value="0,0,0,8" />
            </Style>
            <Style x:Key="Number" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                <Setter Property="Width" Value="80" />
                <Setter Property="Height" Value="24" />
                <Setter Property="HorizontalContentAlignment" Value="Right" />
                <Setter Property="HorizontalAlignment" Value="Left" />
            </Style>
            <Style x:Key="Choice" TargetType="ComboBox">
                <Setter Property="Height" Value="24" />
                <Setter Property="MinWidth" Value="220" />
                <Setter Property="HorizontalAlignment" Value="Left" />
            </Style>
            <Style x:Key="SectionTitle" TargetType="TextBlock">
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="Margin" Value="0,0,0,10" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel>
        <!-- Кнопки -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource StatusBar}" Padding="12,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource DialogButton}" IsDefault="True" Click="OnOk">ОК</Button>
                    <Button Style="{StaticResource DialogButton}" IsCancel="True">Отмена</Button>
                </StackPanel>
                <TextBlock x:Name="ErrorText" Foreground="{StaticResource ErrorBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
            </DockPanel>
        </Border>

        <!-- Заголовок: кого касается -->
        <Border DockPanel.Dock="Top" Style="{StaticResource PanelHeader}" Padding="16,10">
            <StackPanel>
                <TextBlock x:Name="ScopeTitle" FontWeight="SemiBold" FontSize="13" />
                <TextBlock x:Name="ScopeText" Style="{StaticResource MutedText}" Margin="0,2,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ===== Параметры ===== -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16,14,16,14" Grid.IsSharedSizeScope="True">
                    <CheckBox x:Name="UseDefaultBox" Margin="0,0,0,14" Checked="OnChanged" Unchecked="OnChanged" />

                    <StackPanel x:Name="OptionsPanel">
                        <TextBlock Text="Параметры" Style="{StaticResource SectionTitle}" />

                        <Grid Style="{StaticResource Field}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Способ" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="ModeBox" Grid.Column="2" Style="{StaticResource Choice}"
                                      DisplayMemberPath="Title" SelectionChanged="OnChanged" />
                        </Grid>

                        <TextBlock x:Name="ModeHint" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,12" />

                        <!-- Прямоугольные вырезы -->
                        <Grid x:Name="SlotWidthRow" Style="{StaticResource Field}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Ширина выреза" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="SlotWidthBox" Grid.Column="2" Style="{StaticResource Number}" TextChanged="OnChanged" />
                            <TextBlock Grid.Column="3" Text="мм" Style="{StaticResource Unit}" />
                        </Grid>

                        <Grid x:Name="SlotPatternRow" Style="{StaticResource Field}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Расположение" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="SlotPatternBox" Grid.Column="2" Style="{StaticResource Choice}" SelectionChanged="OnChanged" />
                        </Grid>

                        <!-- Прорези по краям -->
                        <Grid x:Name="EdgeCutRow" Style="{StaticResource Field}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Длина прорези у края" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="EdgeCutBox" Grid.Column="2" Style="{StaticResource Number}" TextChanged="OnChanged" />
                            <TextBlock Grid.Column="3" Text="мм" Style="{StaticResource Unit}" />
                        </Grid>

                        <!-- Прерывистая раскладка (прерывистая линия и прерывистые вырезы) -->
                        <Grid x:Name="SpecRow" Style="{StaticResource Field}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Задать" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="SpecBox" Grid.Column="2" Style="{StaticResource Choice}" SelectionChanged="OnChanged" />
                        </Grid>

                        <Grid x:Name="DashRow" Style="{StaticResource Field}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="DashLabel" Text="Длина прорези" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="DashBox" Grid.Column="2" Style="{StaticResource Number}" TextChanged="OnChanged" />
                            <TextBlock Grid.Column="3" Text="мм" Style="{StaticResource Unit}" />
                        </Grid>

                        <Grid x:Name="BridgeRow" Style="{StaticResource Field}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Длина перемычки" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="BridgeBox" Grid.Column="2" Style="{StaticResource Number}" TextChanged="OnChanged" />
                            <TextBlock Grid.Column="3" Text="мм" Style="{StaticResource Unit}" />
                        </Grid>

                        <Grid x:Name="CountRow" Style="{StaticResource Field}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="CountLabel" Text="Количество" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="CountBox" Grid.Column="2" Style="{StaticResource Number}" TextChanged="OnChanged" />
                            <TextBlock Grid.Column="3" Text="шт" Style="{StaticResource Unit}" />
                        </Grid>

                        <Grid x:Name="EndsRow" Style="{StaticResource Field}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="У краёв линии" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="EndsBox" Grid.Column="2" Style="{StaticResource Choice}" SelectionChanged="OnChanged" />
                        </Grid>

                        <Grid x:Name="FitRow" Style="{StaticResource Field}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Подгонка под длину" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="FitBox" Grid.Column="2" Style="{StaticResource Choice}" SelectionChanged="OnChanged" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Column="1" Width="1" Background="{StaticResource BorderBrush}" />

            <!-- ===== Расчёт ===== -->
            <DockPanel Grid.Column="2" Margin="16,14,16,10">
                <TextBlock DockPanel.Dock="Top" Text="Расчёт" Style="{StaticResource SectionTitle}" />
                <TextBlock x:Name="SampleTitle" DockPanel.Dock="Top" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,8" />
                <StackPanel x:Name="SampleLengthPanel" DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Длина линии для примера" Style="{StaticResource FieldLabel}" Margin="0,0,10,0" />
                    <TextBox x:Name="SampleLengthBox" Style="{StaticResource Number}" Text="200" TextChanged="OnChanged" />
                    <TextBlock Text="мм" Style="{StaticResource Unit}" />
                </StackPanel>

                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="{StaticResource WindowBrush}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="LayoutList" Margin="10,6">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource GridLineBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding Title}" FontWeight="SemiBold" Margin="0,0,10,0" />
                                                <TextBlock Text="{Binding Layout.Description}" Style="{StaticResource MutedText}"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Layout.Description}" />
                                            </DockPanel>
                                            <local:BendLineBar Layout="{Binding Layout}" Margin="0,6,0,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
