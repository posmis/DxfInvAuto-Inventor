<Window x:Class="InvAuto.Features.SheetMetal.BendLinesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:InvAuto.Features.SheetMetal"
        xmlns:ui="clr-namespace:InvAuto.Framework.Ui"
        Title="Линии гиба детали"
        Width="1180" Height="680" MinWidth="980" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBrush}"
        FontFamily="Segoe UI" FontSize="12"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/InvAuto;component/Framework/Ui/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>


            <!-- Строка списка линий: номер в кружке, направление и длина, применённые параметры -->
            <DataTemplate x:Key="LineTemplate">
                <DockPanel Margin="2,4">
                    <Border DockPanel.Dock="Left" Width="22" Height="22" CornerRadius="11" Margin="0,0,10,0"
                            BorderBrush="{StaticResource TextBrush}" BorderThickness="1" Background="{StaticResource WindowBrush}"
                            VerticalAlignment="Top">
                        <TextBlock Text="{Binding Number}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" />
                    </Border>
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                        <TextBlock x:Name="Summary" Text="{Binding Summary}" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DockPanel>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsOwn}" Value="True">
                        <Setter TargetName="Summary" Property="Foreground" Value="{StaticResource AccentBrush}" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel>
        <!-- Кнопки -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource StatusBar}" Padding="12,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource DialogButton}" IsDefault="True" Click="OnOk">ОК</Button>
                    <Button Style="{StaticResource DialogButton}" IsCancel="True">Отмена</Button>
                </StackPanel>
                <Button DockPanel.Dock="Left" Style="{StaticResource DialogButton}" Margin="0,0,12,0" MinWidth="170"
                        Click="OnResetAll" ToolTip="Все линии берут параметры детали">Все линии как у детали</Button>
                <TextBlock x:Name="ErrorText" Foreground="{StaticResource ErrorBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
            </DockPanel>
        </Border>

        <!-- Заголовок -->
        <Border DockPanel.Dock="Top" Style="{StaticResource PanelHeader}" Padding="16,10">
            <StackPanel>
                <TextBlock x:Name="PartTitle" FontWeight="SemiBold" FontSize="13" />
                <TextBlock x:Name="PartText" Style="{StaticResource MutedText}" Margin="0,2,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="380" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ===== Линии ===== -->
            <DockPanel Margin="16,14,12,14">
                <TextBlock DockPanel.Dock="Top" Text="Линии гиба" Style="{StaticResource SectionTitle}" />
                <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,0"
                           Text="Ctrl/Shift + щелчок — несколько линий. Выделенные подсвечены на развертке." />
                <ListBox x:Name="LinesList" SelectionMode="Extended" ItemTemplate="{StaticResource LineTemplate}"
                         BorderBrush="{StaticResource BorderBrush}" SelectionChanged="OnSelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
            </DockPanel>

            <Border Grid.Column="1" Width="1" Background="{StaticResource BorderBrush}" />

            <!-- ===== Параметры выделенных ===== -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16,14,16,14">
                    <TextBlock x:Name="SelectionTitle" Style="{StaticResource SectionTitle}" />
                    <CheckBox x:Name="AsPartBox" Margin="0,0,0,14" Click="OnAsPartClick" />
                    <local:BendOptionsEditor x:Name="Editor" Changed="OnEditorChanged" />
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Column="3" Width="1" Background="{StaticResource BorderBrush}" />

            <!-- ===== Развертка и расчёт ===== -->
            <Grid Grid.Column="4" Margin="16,14,16,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="2*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="90" />
                </Grid.RowDefinitions>
                <TextBlock Text="Развертка" Style="{StaticResource SectionTitle}" />
                <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="{StaticResource WindowBrush}">
                    <ui:FlatPatternView x:Name="Preview" Margin="14"
                                        ProfileBrush="{StaticResource FlatProfileBrush}"
                                        BendBrush="{StaticResource FlatBendBrush}"
                                        AuxiliaryBrush="{StaticResource FlatAuxBrush}" />
                </Border>
                <TextBlock Grid.Row="2" Text="Расчёт выделенных линий" Style="{StaticResource SectionTitle}" Margin="0,12,0,8" />
                <Border Grid.Row="3" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="{StaticResource WindowBrush}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="LayoutList" Margin="10,4">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource GridLineBrush}" BorderThickness="0,0,0,1" Padding="0,6">
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding Title}" FontWeight="SemiBold" Margin="0,0,10,0" />
                                                <TextBlock Text="{Binding Layout.Description}" Style="{StaticResource MutedText}"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Layout.Description}" />
                                            </DockPanel>
                                            <local:BendLineBar Layout="{Binding Layout}" Margin="0,5,0,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
