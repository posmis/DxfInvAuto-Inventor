<Window x:Class="InvAuto.Features.SheetMetal.ExportSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Параметры выгрузки DXF"
        Width="620" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBrush}"
        FontFamily="Segoe UI" FontSize="12"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/InvAuto;component/Framework/Ui/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="Section" TargetType="TextBlock">
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,14,0,6" />
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            </Style>
            <Style x:Key="Label" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="0,0,12,0" />
            </Style>
            <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Margin" Value="0,3,0,0" />
                <Setter Property="FontSize" Value="11" />
            </Style>
            <Style TargetType="CheckBox">
                <Setter Property="Margin" Value="0,3" />
            </Style>
            <Style TargetType="RadioButton">
                <Setter Property="Margin" Value="0,3" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Style="{StaticResource StatusBar}" Padding="12,8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource DialogButton}" IsDefault="True" Click="OnOk">ОК</Button>
                <Button Style="{StaticResource DialogButton}" IsCancel="True">Отмена</Button>
            </StackPanel>
        </Border>

        <StackPanel Margin="16,4,16,14">

            <!-- Файлы -->
            <TextBlock Text="Файлы" Style="{StaticResource Section}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="Папка" Style="{StaticResource Label}" />
                <TextBox x:Name="FolderBox" Grid.Column="1" Height="24" />
                <Button Grid.Column="2" Content="Обзор…" Style="{StaticResource DialogButton}" Click="OnBrowseFolder" />
                <TextBlock x:Name="FolderHint" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource Hint}" />

                <TextBlock Grid.Row="2" Text="Имя файла" Style="{StaticResource Label}" Margin="0,8,12,0" />
                <TextBox x:Name="NameBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Height="24" Margin="0,8,0,0" TextChanged="OnTemplateChanged" />

                <TextBlock Grid.Row="3" Text="Подпапки" Style="{StaticResource Label}" Margin="0,6,12,0" />
                <TextBox x:Name="SubfolderBox" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Height="24" Margin="0,6,0,0" TextChanged="OnTemplateChanged" />

                <TextBlock Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource Hint}">
                    Поля: {Name} {PartNumber} {Description} {Material} {Thickness:0.0} {Qty} {Length} {Width} {Assembly}
                    и любые пользовательские iProperties, например {Заказ}. Подпапки: {Material}\{Thickness:0.0}мм
                </TextBlock>

                <TextBlock Grid.Row="5" Text="Пример" Style="{StaticResource Label}" Margin="0,8,12,0" />
                <TextBlock x:Name="PreviewText" Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,8,0,0"
                           Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" />
            </Grid>

            <!-- Способ выгрузки -->
            <TextBlock Text="Способ выгрузки DXF" Style="{StaticResource Section}" />
            <RadioButton x:Name="IniMethod" GroupName="Method" Checked="OnMethodChanged">
                По ini-файлу через транслятор DXF Inventor (рекомендуется)
            </RadioButton>
            <Grid Margin="20,4,0,0" x:Name="IniPanel">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBox x:Name="IniBox" Height="24" />
                <Button Grid.Column="1" Content="Обзор…" Style="{StaticResource DialogButton}" Click="OnBrowseIni" />
                <TextBlock x:Name="IniHint" Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource Hint}" />
            </Grid>

            <RadioButton x:Name="FormatMethod" GroupName="Method" Margin="0,10,0,3" Checked="OnMethodChanged">
                По параметрам (DataIO)
            </RadioButton>
            <Grid Margin="20,4,0,0" x:Name="FormatPanel">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="Версия AutoCAD" Style="{StaticResource Label}" />
                <ComboBox x:Name="AcadBox" Grid.Column="1" Height="24" />

                <TextBlock Grid.Row="1" Text="Слой контура" Style="{StaticResource Label}" Margin="0,6,12,0" />
                <TextBox x:Name="OuterLayerBox" Grid.Row="1" Grid.Column="1" Height="24" Margin="0,6,0,0" />
                <TextBlock Grid.Row="1" Grid.Column="2" Text="пусто — IV_OUTER_PROFILE" Style="{StaticResource Hint}" Margin="8,6,0,0" VerticalAlignment="Center" />

                <TextBlock Grid.Row="2" Text="Слой отверстий" Style="{StaticResource Label}" Margin="0,6,12,0" />
                <TextBox x:Name="InnerLayerBox" Grid.Row="2" Grid.Column="1" Height="24" Margin="0,6,0,0" />
                <TextBlock Grid.Row="2" Grid.Column="2" Text="пусто — IV_INTERIOR_PROFILES" Style="{StaticResource Hint}" Margin="8,6,0,0" VerticalAlignment="Center" />

                <TextBlock Grid.Row="3" Text="Слои гиба" Style="{StaticResource Label}" Margin="0,6,12,0" />
                <StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBox x:Name="BendUpLayerBox" Width="120" Height="24" />
                    <TextBox x:Name="BendDownLayerBox" Width="120" Height="24" Margin="6,0,0,0" />
                    <TextBlock Text="пусто — IV_BEND / IV_BEND_DOWN" Style="{StaticResource Hint}" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <CheckBox x:Name="BendLinesBox" Grid.Row="4" Grid.ColumnSpan="3" Margin="0,8,0,0">Линии гиба</CheckBox>
            </Grid>

            <!-- Прочее -->
            <TextBlock Text="Дополнительно" Style="{StaticResource Section}" />
            <CheckBox x:Name="CreateFlatBox">Создавать развертку, если её нет (деталь потребует сохранения)</CheckBox>
            <CheckBox x:Name="OverwriteBox">Перезаписывать существующие файлы</CheckBox>
            <CheckBox x:Name="CsvBox">Создавать CSV-отчёт</CheckBox>
            <CheckBox x:Name="OpenFolderBox">Открывать папку после выгрузки</CheckBox>
        </StackPanel>
    </DockPanel>
</Window>
