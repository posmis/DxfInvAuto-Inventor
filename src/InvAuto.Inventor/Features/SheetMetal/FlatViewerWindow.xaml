<Window x:Class="InvAuto.Features.SheetMetal.FlatViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:InvAuto.Framework.Ui"
        Title="Просмотр развертки"
        Width="1200" Height="780" MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBrush}"
        FontFamily="Segoe UI" FontSize="12"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True"
        PreviewKeyDown="OnKeyDown">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/InvAuto;component/Framework/Ui/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="MeasureBrush" Color="#D9480F" />
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel>
        <!-- Панель инструментов -->
        <Border DockPanel.Dock="Top" Style="{StaticResource RibbonBar}" Padding="8,6">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button x:Name="PrevButton" Style="{StaticResource ToolButton}" Tag="{StaticResource Icon.NavPrev.Small}" Click="OnPrev"
                            ToolTip="Предыдущая деталь (PageUp)" />
                    <Button x:Name="NextButton" Style="{StaticResource ToolButton}" Tag="{StaticResource Icon.NavNext.Small}" Click="OnNext"
                            ToolTip="Следующая деталь (PageDown)" />
                    <Border Style="{StaticResource ToolSeparator}" />
                    <ToggleButton x:Name="DistanceTool" Style="{StaticResource ToolButton}" Tag="{StaticResource Icon.MeasureDistance.Small}"
                                  Click="OnDistanceTool"
                                  ToolTip="Расстояние между двумя точками (D).&#x0a;Привязки: конец, середина, центр, точка на линии; Ctrl — без привязки.">Расстояние</ToggleButton>
                    <ToggleButton x:Name="AngleTool" Style="{StaticResource ToolButton}" Tag="{StaticResource Icon.MeasureAngle.Small}"
                                  Click="OnAngleTool"
                                  ToolTip="Угол между двумя отрезками (A).&#x0a;Щёлкайте по тем частям отрезков, между которыми нужен угол.">Угол</ToggleButton>
                    <Button x:Name="ClearMeasuresButton" Style="{StaticResource ToolButton}" Tag="{StaticResource Icon.MeasureClear.Small}"
                            Click="OnClearMeasures" IsEnabled="False" ToolTip="Удалить все измерения">Очистить</Button>
                    <Border Style="{StaticResource ToolSeparator}" />
                    <ToggleButton x:Name="MarkingTool" Style="{StaticResource ToolButton}" Tag="{StaticResource Icon.Marking.Small}"
                                  Click="OnMarkingTool"
                                  ToolTip="Место маркировки вручную (M): перетащите текст или щёлкните, куда его поставить.&#x0a;Место запоминается для детали и используется при выгрузке.">Маркировка</ToggleButton>
                    <Button x:Name="MarkingRotateButton" Style="{StaticResource ToolButton}" Click="OnMarkingRotate" Visibility="Collapsed"
                            ToolTip="Повернуть текст на 90° (R)">Повернуть</Button>
                    <Button x:Name="MarkingAutoButton" Style="{StaticResource ToolButton}" Click="OnMarkingAuto" Visibility="Collapsed"
                            ToolTip="Вернуть автоматическое место маркировки">Авто</Button>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <ToggleButton x:Name="NumbersToggle" Style="{StaticResource ToolButton}" Tag="{StaticResource Icon.BendNumbers.Small}"
                                  IsChecked="True" Click="OnNumbersToggle" ToolTip="Номера линий гиба на развертке">Номера линий</ToggleButton>
                    <Border Style="{StaticResource ToolSeparator}" />
                    <Button Style="{StaticResource ToolButton}" Tag="{StaticResource Icon.ZoomOut.Small}" Click="OnZoomOut" ToolTip="Уменьшить (−)" />
                    <Button Style="{StaticResource ToolButton}" Tag="{StaticResource Icon.ZoomIn.Small}" Click="OnZoomIn" ToolTip="Увеличить (+)" />
                    <Button Style="{StaticResource ToolButton}" Tag="{StaticResource Icon.ZoomFit.Small}" Click="OnFit"
                            ToolTip="Показать развертку целиком (Home, двойной щелчок)">Вписать</Button>
                </StackPanel>
                <TextBlock x:Name="PartTitle" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" Margin="12,0"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <!-- Строка состояния -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource StatusBar}">
            <DockPanel>
                <TextBlock x:Name="PositionText" DockPanel.Dock="Right" Style="{StaticResource MutedText}" Margin="16,0,0,0" MinWidth="110" />
                <TextBlock x:Name="CursorText" DockPanel.Dock="Right" Style="{StaticResource MutedText}" Margin="16,0,0,0" MinWidth="170" />
                <TextBlock x:Name="ZoomText" DockPanel.Dock="Right" Style="{StaticResource MutedText}" MinWidth="110" />
                <TextBlock x:Name="HintText" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <!-- Развертка -->
            <Grid Background="{StaticResource WindowBrush}">
                <ui:FlatPatternView x:Name="View" Interactive="True" Cursor="Cross" Margin="0"
                                    ProfileBrush="{StaticResource FlatProfileBrush}"
                                    BendBrush="{StaticResource FlatBendBrush}"
                                    AuxiliaryBrush="{StaticResource FlatAuxBrush}"
                                    ViewChanged="OnViewChanged" CursorMoved="OnCursorMoved" ModelClicked="OnModelClicked" />
                <TextBlock x:Name="EmptyText" Style="{StaticResource MutedText}" FontSize="13"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
            </Grid>

            <Border Grid.Column="1" Width="1" Background="{StaticResource BorderBrush}" />

            <!-- Свойства -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="14,12">
                    <DockPanel Margin="0,0,0,8">
                        <Button x:Name="CopyMeasuresButton" DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Click="OnCopyMeasures"
                                IsEnabled="False" ToolTip="Скопировать измерения в буфер обмена">Копировать</Button>
                        <TextBlock Text="Измерения" Style="{StaticResource PanelTitle}" />
                    </DockPanel>
                    <TextBlock x:Name="NoMeasuresText" Style="{StaticResource MutedText}" TextWrapping="Wrap"
                               Text="Нет измерений. Выберите «Расстояние» или «Угол» на панели инструментов." />
                    <ItemsControl x:Name="MeasureList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,0,0,6">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="×" FontSize="14"
                                            Tag="{Binding}" Click="OnRemoveMeasure" ToolTip="Удалить измерение" />
                                    <TextBlock Text="{Binding Number, StringFormat={}{0})}" FontWeight="SemiBold" Margin="0,0,6,0"
                                               Foreground="{StaticResource MeasureBrush}" />
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Свойства" Style="{StaticResource PanelTitle}" Margin="0,16,0,8" />
                    <ui:PropertyTable x:Name="PropertiesTable" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
