<Window x:Class="InvAuto.Features.SheetMetal.SheetMetalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:InvAuto.Framework.Ui"
        Title="Листовые детали"
        Width="1600" Height="860" MinWidth="960" MinHeight="520"
        Background="{DynamicResource WindowBrush}"
        FontFamily="Segoe UI" FontSize="12"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        PreviewKeyDown="OnWindowKeyDown">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/InvAuto;component/Framework/Ui/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- ===== Ячейки дерева ===== -->

            <Style x:Key="ExpanderToggle" TargetType="ToggleButton">
                <Setter Property="Width" Value="16" />
                <Setter Property="Height" Value="16" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border Background="Transparent">
                                <TextBlock x:Name="Glyph" Style="{StaticResource IconText}" FontSize="9"
                                           Foreground="{StaticResource MutedTextBrush}" Text="&#xE76C;" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Glyph" Property="Text" Value="&#xE70D;" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource TextBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding HasChildren}" Value="False">
                        <Setter Property="Visibility" Value="Hidden" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <DataTemplate x:Key="TreeTitleCell">
                <StackPanel Orientation="Horizontal" Margin="{Binding Indent}" ToolTip="{Binding ToolTip}">
                    <ToggleButton Style="{StaticResource ExpanderToggle}" IsChecked="{Binding IsExpanded, Mode=OneWay}" Click="OnTreeToggle" />
                    <Image x:Name="Icon" Width="16" Height="16" Margin="3,0,6,0" Source="{StaticResource Icon.Part.Small}" />
                    <TextBlock x:Name="Title" Text="{Binding Title}" VerticalAlignment="Center" />
                    <TextBlock x:Name="ListedMark" Style="{StaticResource IconText}" Text="&#xE73E;" FontSize="11" Margin="6,1,0,0"
                               Foreground="{StaticResource OkBrush}" Visibility="Collapsed" />
                </StackPanel>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsSheetMetal}" Value="True">
                        <Setter TargetName="Icon" Property="Source" Value="{StaticResource Icon.SheetMetalPart.Small}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding InList}" Value="True">
                        <Setter TargetName="ListedMark" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsStandard}" Value="True">
                        <Setter TargetName="Icon" Property="Source" Value="{StaticResource Icon.StandardPart.Small}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsAssembly}" Value="True">
                        <Setter TargetName="Icon" Property="Source" Value="{StaticResource Icon.Assembly.Small}" />
                        <Setter TargetName="Title" Property="FontWeight" Value="SemiBold" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <!-- ===== Ячейки списка деталей ===== -->

            <DataTemplate x:Key="CheckCell">
                <CheckBox IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}"
                          HorizontalAlignment="Center" VerticalAlignment="Center" Focusable="False" />
            </DataTemplate>

            <DataTemplate x:Key="FlatCell">
                <Grid Height="48" Width="96">
                    <ui:FlatPatternView x:Name="View" Drawing="{Binding Flat}"
                                        ProfileBrush="{StaticResource FlatProfileBrush}"
                                        BendBrush="{StaticResource FlatBendBrush}"
                                        AuxiliaryBrush="{StaticResource FlatAuxBrush}" />
                    <TextBlock x:Name="NoFlat" Text="{Binding FlatPreviewText}" ToolTip="{Binding FlatPreviewError}"
                               Style="{StaticResource MutedText}" FontSize="11"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding FlatPreviewState}" Value="Ready">
                        <Setter TargetName="NoFlat" Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding FlatPreviewState}" Value="Failed">
                        <Setter TargetName="NoFlat" Property="Foreground" Value="{StaticResource ErrorBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding FlatPreviewState}" Value="NoFlatPattern">
                        <Setter TargetName="NoFlat" Property="Foreground" Value="{StaticResource WarningBrush}" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <DataTemplate x:Key="ThumbnailCell">
                <Image Source="{Binding Thumbnail}" Height="48" Width="64" Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality" />
            </DataTemplate>

            <DataTemplate x:Key="LibraryMaterialCell">
                <TextBlock x:Name="Text" Text="{Binding LibraryMaterialText}" ToolTip="{Binding LibraryMaterialHint}"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding MaterialManual}" Value="True">
                        <Setter TargetName="Text" Property="FontWeight" Value="SemiBold" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding MaterialMissing}" Value="True">
                        <Setter TargetName="Text" Property="Foreground" Value="{StaticResource WarningBrush}" />
                        <Setter TargetName="Text" Property="FontStyle" Value="Italic" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding MaterialMismatch}" Value="True">
                        <Setter TargetName="Text" Property="Foreground" Value="{StaticResource ErrorBrush}" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <DataTemplate x:Key="FlatStateCell">
                <TextBlock x:Name="Text" Text="{Binding FlatState}" Foreground="{StaticResource OkBrush}" />
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding HasFlatPattern}" Value="False">
                        <Setter TargetName="Text" Property="Foreground" Value="{StaticResource WarningBrush}" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <DataTemplate x:Key="StatusCell">
                <StackPanel Orientation="Horizontal" ToolTip="{Binding Status}">
                    <Ellipse x:Name="Dot" Width="7" Height="7" Margin="0,0,6,0" Fill="Transparent" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </StackPanel>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding StatusKind}" Value="Ok">
                        <Setter TargetName="Dot" Property="Fill" Value="{StaticResource OkBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding StatusKind}" Value="Warning">
                        <Setter TargetName="Dot" Property="Fill" Value="{StaticResource WarningBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding StatusKind}" Value="Error">
                        <Setter TargetName="Dot" Property="Fill" Value="{StaticResource ErrorBrush}" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <!-- Панель команд вкладки: на узком экране прокручивается, а не обрезается -->
            <Style x:Key="RibbonScroll" TargetType="ScrollViewer">
                <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
                <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
                <Setter Property="Focusable" Value="False" />
            </Style>

            <!-- Кнопки в заголовке панели — той же высоты, что поле поиска -->
            <Style x:Key="HeaderToolButton" TargetType="ButtonBase" BasedOn="{StaticResource ToolButton}">
                <Setter Property="Height" Value="24" />
                <Setter Property="MinWidth" Value="24" />
                <Setter Property="Padding" Value="2,0" />
            </Style>

            <Style x:Key="RightAligned" TargetType="TextBlock">
                <Setter Property="HorizontalAlignment" Value="Right" />
            </Style>


        </ResourceDictionary>
    </Window.Resources>

    <DockPanel>

        <!-- ===================== Лента команд =====================
             Вкладки по назначению, как в Inventor: «Главная» — собрать список, отметить, выгрузить;
             «Развертки» — проверить развертки и линии гиба; «Вид» — колонки, сортировка, панели;
             «Настройки» — параметры выгрузки и приложения. Открытая вкладка запоминается. -->
        <TabControl x:Name="RibbonTabs" DockPanel.Dock="Top" Style="{StaticResource RibbonTabs}">
            <TabItem Header="Главная">
                <ScrollViewer Style="{StaticResource RibbonScroll}">
                    <StackPanel Orientation="Horizontal">
                        <HeaderedContentControl Header="Состав" Style="{StaticResource RibbonGroup}">
                            <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource Icon.Refresh}" Click="OnRefresh"
                                    ToolTip="Заново прочитать состав активной сборки. Список деталей сохраняется.">Обновить</Button>
                        </HeaderedContentControl>

                        <HeaderedContentControl Header="Список" Style="{StaticResource RibbonGroup}">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource Icon.ListAdd}" Click="OnAddSelected"
                                        ToolTip="Добавить в список листовые детали выделенных узлов дерева&#x0a;(также двойной щелчок, Enter или Insert в дереве)">Добавить</Button>
                                <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource Icon.ListAddAll}" Click="OnAddAll"
                                        ToolTip="Добавить в список все листовые детали изделия (Ctrl+Shift+A)">Добавить все</Button>
                                <StackPanel Margin="2,0,0,0">
                                    <Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource Icon.ListRemove.Small}" Click="OnRemoveSelected"
                                            ToolTip="Убрать выделенные строки из списка (Delete)">Удалить</Button>
                                    <Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource Icon.ListClear.Small}" Click="OnClearList"
                                            ToolTip="Убрать из списка все детали">Очистить</Button>
                                </StackPanel>
                            </StackPanel>
                        </HeaderedContentControl>

                        <HeaderedContentControl Header="Отметка" Style="{StaticResource RibbonGroup}">
                            <StackPanel>
                                <Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource Icon.CheckAll.Small}" Click="OnCheckAll">Отметить все</Button>
                                <Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource Icon.CheckNone.Small}" Click="OnCheckNone">Снять все</Button>
                                <Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource Icon.CheckSelected.Small}" Click="OnCheckSelected"
                                        ToolTip="Отметить только выделенные строки (выделение — Ctrl/Shift + щелчок)">Только выделенные</Button>
                            </StackPanel>
                        </HeaderedContentControl>

                        <HeaderedContentControl Header="Выгрузка DXF" Style="{StaticResource RibbonGroup}">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RibbonPrimaryButton}" Tag="{StaticResource Icon.Export}" Click="OnExportChecked"
                                        ToolTip="Выгрузить детали списка, отмеченные галочкой">Выгрузить отмеченные</Button>
                                <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource Icon.ExportAll}" Click="OnExportAll"
                                        ToolTip="Выгрузить все листовые детали изделия, независимо от выбора">Выгрузить всё</Button>
                                <StackPanel Margin="2,0,0,0">
                                    <Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource Icon.OpenFolder.Small}" Click="OnOpenFolder">Открыть папку</Button>
                                    <StackPanel Orientation="Horizontal" Margin="6,3,4,0" ToolTip="Количество каждой детали умножается на это число">
                                        <TextBlock Text="Изделий:" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBox x:Name="ProductQuantityBox" Width="46" Text="1" HorizontalContentAlignment="Right"
                                                 LostFocus="OnProductQuantityChanged" KeyDown="OnProductQuantityKeyDown" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </HeaderedContentControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Развертки">
                <ScrollViewer Style="{StaticResource RibbonScroll}">
                    <StackPanel Orientation="Horizontal">
                        <HeaderedContentControl Header="Развертки" Style="{StaticResource RibbonGroup}">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource Icon.FlatView}" Click="OnOpenViewer"
                                        ToolTip="Просмотр развертки выделенной детали: масштаб колесом мыши, перемещение мышью.&#x0a;Также — двойной щелчок по строке.">Просмотр</Button>
                                <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource Icon.FlatPattern}" Click="OnGenerateFlats"
                                        ToolTip="Сформировать развертки отмеченных деталей для просмотра перед выгрузкой.&#x0a;DXF создаётся тем же способом, что и при выгрузке, и хранится во временной папке.">Сформировать развертки</Button>
                                <StackPanel Margin="2,0,0,0">
                                    <Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource Icon.Refresh.Small}" Click="OnRegenerateSelected"
                                            ToolTip="Сформировать развертки выделенных строк заново, даже если они уже есть в кэше">Заново для выделенных</Button>
                                </StackPanel>
                            </StackPanel>
                        </HeaderedContentControl>

                        <HeaderedContentControl Header="Линии гиба" Style="{StaticResource RibbonGroup}">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource Icon.BendLines}" Click="OnBendSelected"
                                        ToolTip="Свои параметры линий гиба для выделенных деталей (все линии детали)">Для выделенных</Button>
                                <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource Icon.BendLinesEach}" Click="OnBendLines"
                                        ToolTip="Настроить линии гиба выделенной детали по отдельности">По линиям</Button>
                                <StackPanel Margin="2,0,0,0">
                                    <Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource Icon.Settings.Small}" Click="OnBendDefaults"
                                            ToolTip="Параметры линий гиба для всех деталей без своих настроек">По умолчанию</Button>
                                    <Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource Icon.Refresh.Small}" Click="OnBendReset"
                                            ToolTip="Вернуть выделенным деталям общие параметры (и для всей детали, и для отдельных линий)">Сбросить к общим</Button>
                                </StackPanel>
                            </StackPanel>
                        </HeaderedContentControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Производство">
                <ScrollViewer Style="{StaticResource RibbonScroll}">
                    <StackPanel Orientation="Horizontal">
                        <HeaderedContentControl Header="Материал" Style="{StaticResource RibbonGroup}">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource Icon.MaterialLibrary}" Click="OnMaterialLibrary"
                                        ToolTip="Материалы листа: наименование, толщина, плотность, материал по умолчанию для толщины.&#x0a;Импорт и экспорт в Excel (CSV) или XML.">Библиотека материалов</Button>
                                <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource Icon.MaterialAssign}" Click="OnAssignMaterial"
                                        ToolTip="Назначить выделенным деталям материал из библиотеки вручную">Назначить материал</Button>
                                <StackPanel Margin="2,0,0,0">
                                    <Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource Icon.Refresh.Small}" Click="OnMaterialByThickness"
                                            ToolTip="Снять ручное назначение: выделенные детали получат материал по умолчанию для своей толщины">По толщине</Button>
                                </StackPanel>
                            </StackPanel>
                        </HeaderedContentControl>

                        <HeaderedContentControl Header="Отчёт" Style="{StaticResource RibbonGroup}">
                            <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource Icon.Report}" Click="OnReport"
                                    ToolTip="Ведомость для заявки на резку: сводка по материалам и толщинам (площадь, масса, длина реза, врезки)&#x0a;и таблица деталей с развертками. Excel и/или PDF на листах A4 с шапкой и нумерацией.">Ведомость</Button>
                        </HeaderedContentControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Вид">
                <ScrollViewer Style="{StaticResource RibbonScroll}">
                    <StackPanel Orientation="Horizontal">
                        <HeaderedContentControl Header="Список" Style="{StaticResource RibbonGroup}">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="ColumnsButton" Style="{StaticResource RibbonButton}" Tag="{StaticResource Icon.Columns}"
                                        Click="OnColumns" ToolTip="Выбор колонок списка деталей">Колонки</Button>
                                <Button x:Name="SortButton" Style="{StaticResource RibbonButton}" Tag="{StaticResource Icon.Sort}" Click="OnSortMenu"
                                        ToolTip="Порядок деталей в списке: по колонке, по возрастанию или убыванию.&#x0a;Также — щелчок по заголовку колонки, повторный щелчок меняет направление.">Сортировка</Button>
                            </StackPanel>
                        </HeaderedContentControl>

                        <HeaderedContentControl Header="Панели" Style="{StaticResource RibbonGroup}">
                            <ToggleButton x:Name="DetailsToggle" Style="{StaticResource RibbonButton}" Tag="{StaticResource Icon.Details}"
                                          Click="OnToggleDetails" ToolTip="Панель свойств выбранной детали справа">Свойства</ToggleButton>
                        </HeaderedContentControl>

                        <HeaderedContentControl Header="Дерево" Style="{StaticResource RibbonGroup}">
                            <StackPanel>
                                <Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource Icon.ExpandAll.Small}" Click="OnExpandAll">Развернуть всё</Button>
                                <Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource Icon.CollapseAll.Small}" Click="OnCollapseAll">Свернуть всё</Button>
                            </StackPanel>
                        </HeaderedContentControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Настройки">
                <ScrollViewer Style="{StaticResource RibbonScroll}">
                    <StackPanel Orientation="Horizontal">
                        <HeaderedContentControl Header="Выгрузка" Style="{StaticResource RibbonGroup}">
                            <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource Icon.Settings}" Click="OnSettings"
                                    ToolTip="Папка, имена файлов, способ выгрузки DXF, раскладка по толщине">Параметры выгрузки</Button>
                        </HeaderedContentControl>

                        <HeaderedContentControl Header="Приложение" Style="{StaticResource RibbonGroup}">
                            <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource Icon.DataFolder}" Click="OnAppSettings"
                                    ToolTip="Запоминание списков, кэш разверток, журнал, сброс настроек">Настройки приложения</Button>
                        </HeaderedContentControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- ===================== Строка состояния ===================== -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource StatusBar}">
            <DockPanel>
                <Button x:Name="CancelButton" DockPanel.Dock="Right" Content="Остановить" Style="{StaticResource DialogButton}"
                        Height="22" Margin="8,0,0,0" Visibility="Collapsed" Click="OnCancel" />
                <ProgressBar x:Name="Progress" DockPanel.Dock="Right" Width="220" Height="12" Visibility="Collapsed" />
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <!-- ===================== Рабочая область ===================== -->
        <Grid x:Name="Body">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TreeColumn" Width="420" MinWidth="220" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="300" />
                <ColumnDefinition x:Name="DetailsSplitterColumn" Width="Auto" />
                <ColumnDefinition x:Name="DetailsColumn" Width="300" />
            </Grid.ColumnDefinitions>

            <!-- Дерево состава -->
            <DockPanel Grid.Column="0">
                <Border DockPanel.Dock="Top" Style="{StaticResource PanelHeader}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource HeaderToolButton}" Tag="{StaticResource Icon.ExpandAll.Small}" Click="OnExpandAll"
                                    ToolTip="Развернуть всё" />
                            <Button Style="{StaticResource HeaderToolButton}" Tag="{StaticResource Icon.CollapseAll.Small}" Click="OnCollapseAll"
                                    ToolTip="Свернуть всё" />
                        </StackPanel>
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,8,0"
                                   Text="двойной щелчок — в список" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="Состав изделия" Style="{StaticResource PanelTitle}" Margin="0,0,8,0" />
                    </DockPanel>
                </Border>
                <DataGrid x:Name="TreeGrid" IsReadOnly="True" SelectionMode="Extended" CanUserSortColumns="False"
                          CanUserReorderColumns="False" RowHeight="24"
                          MouseDoubleClick="OnTreeDoubleClick" PreviewKeyDown="OnTreeKeyDown">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Добавить в список" InputGestureText="Enter" Click="OnAddSelected" FontWeight="SemiBold" />
                            <MenuItem Header="Добавить все детали изделия" InputGestureText="Ctrl+Shift+A" Click="OnAddAll" />
                            <Separator />
                            <MenuItem Header="Развернуть всё" Click="OnExpandAll" />
                            <MenuItem Header="Свернуть всё" Click="OnCollapseAll" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Обозначение" Width="2*" CellTemplate="{StaticResource TreeTitleCell}" />
                        <DataGridTextColumn Header="Наименование" Width="1.4*" Binding="{Binding Description}" />
                        <DataGridTextColumn Header="Кол." Width="44" Binding="{Binding QuantityInParent}"
                                            ElementStyle="{StaticResource RightAligned}" />
                        <DataGridTextColumn Header="Всего" Width="50" Binding="{Binding TotalQuantity}"
                                            ElementStyle="{StaticResource RightAligned}" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>

            <GridSplitter Grid.Column="1" Style="{StaticResource Splitter}" />

            <!-- Список деталей, собранный пользователем -->
            <DockPanel Grid.Column="2">
                <Border DockPanel.Dock="Top" Style="{StaticResource PanelHeader}">
                    <DockPanel>
                        <Grid DockPanel.Dock="Right" Width="220" Margin="12,0,0,0">
                            <TextBox x:Name="SearchBox" Height="24" Padding="22,1,4,1" TextChanged="OnSearchChanged" PreviewKeyDown="OnSearchKeyDown"
                                     ToolTip="Фильтр списка: имя файла, обозначение, наименование, материал, свойства" />
                            <TextBlock Text="&#xE721;" Style="{StaticResource IconText}" FontSize="11" HorizontalAlignment="Left" Margin="7,0,0,0"
                                       Foreground="{StaticResource MutedTextBrush}" IsHitTestVisible="False" />
                            <TextBlock Text="Поиск в списке (Ctrl+F)" Margin="24,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <TextBlock x:Name="CounterText" DockPanel.Dock="Right" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                        <TextBlock x:Name="PartsTitle" Text="Список деталей" Style="{StaticResource PanelTitle}" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                </Border>
                <Grid>
                    <DataGrid x:Name="PartsGrid" IsReadOnly="True" SelectionMode="Extended" RowHeight="56"
                              SelectionChanged="OnPartSelectionChanged" PreviewKeyDown="OnPartsKeyDown"
                              ColumnReordered="OnColumnReordered" MouseDoubleClick="OnPartsDoubleClick" Sorting="OnPartsSorting">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Отметить выделенные" Click="OnCheckSelectedRows" />
                                <MenuItem Header="Снять отметку с выделенных" Click="OnUncheckSelectedRows" />
                                <Separator />
                                <MenuItem Header="Удалить из списка" InputGestureText="Delete" Click="OnRemoveSelected" />
                                <Separator />
                                <MenuItem Header="Показать файл детали в проводнике" Click="OnRevealPart" />
                                <MenuItem Header="Просмотр развертки" Click="OnOpenViewer" FontWeight="SemiBold" />
                                <MenuItem Header="Сформировать развертку заново" Click="OnRegenerateSelected" />
                                <MenuItem Header="Линии гиба по отдельности…" Click="OnBendLines" />
                                <MenuItem Header="Назначить материал…" Click="OnAssignMaterial" />
                                <MenuItem Header="Материал по толщине" Click="OnMaterialByThickness" />
                                <Separator />
                                <MenuItem Header="Показать DXF в проводнике" Click="OnRevealDxf" />
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                    </DataGrid>
                    <TextBlock x:Name="EmptyText" Style="{StaticResource MutedText}" HorizontalAlignment="Center"
                               VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="24" Visibility="Collapsed"
                               IsHitTestVisible="False">
                        Список пуст.<LineBreak />
                        Дважды щёлкните по сборке или детали в дереве слева, чтобы добавить её листовые детали,<LineBreak />
                        или нажмите «Добавить все» (Ctrl+Shift+A).
                    </TextBlock>
                </Grid>
            </DockPanel>

            <GridSplitter x:Name="DetailsSplitter" Grid.Column="3" Style="{StaticResource Splitter}" />

            <!-- Свойства выбранной детали -->
            <DockPanel x:Name="DetailsPanel" Grid.Column="4">
                <Border DockPanel.Dock="Top" Style="{StaticResource PanelHeader}">
                    <TextBlock Text="Свойства" Style="{StaticResource PanelTitle}" />
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="Details" Margin="10" DataContext="{x:Null}">
                        <TextBlock x:Name="DetailsHint" Style="{StaticResource MutedText}" TextWrapping="Wrap"
                                   Text="Выберите деталь в списке" />

                        <StackPanel x:Name="DetailsContent" Visibility="Collapsed">
                            <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,8" />

                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Height="200" Background="{StaticResource WindowBrush}"
                                    MouseLeftButtonDown="OnDetailsFlatClick" Cursor="Hand" ToolTip="Двойной щелчок — просмотр развертки">
                                <Grid>
                                    <ui:FlatPatternView Drawing="{Binding Flat}" Margin="10"
                                                        ProfileBrush="{StaticResource FlatProfileBrush}"
                                                        BendBrush="{StaticResource FlatBendBrush}"
                                                        AuxiliaryBrush="{StaticResource FlatAuxBrush}" />
                                    <TextBlock Text="{Binding FlatPreviewText}" ToolTip="{Binding FlatPreviewError}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding FlatPreviewState}" Value="Ready">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding FlatPreviewState}" Value="Failed">
                                                        <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>
                            <DockPanel Margin="0,4,0,10">
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource MutedText}" Text="{Binding FlatSizeText}" />
                                <TextBlock Text="Развертка" Style="{StaticResource MutedText}" />
                            </DockPanel>

                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Height="160" Background="{StaticResource WindowBrush}">
                                <Image Source="{Binding Thumbnail}" Margin="6" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>
                            <TextBlock Text="Деталь" Style="{StaticResource MutedText}" Margin="0,4,0,12" />

                            <!-- Таблица свойств: группы «параметр | значение | единица», как Details в Ansys -->
                            <ui:PropertyTable x:Name="PropertiesTable" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
