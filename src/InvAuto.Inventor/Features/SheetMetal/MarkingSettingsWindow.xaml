<Window x:Class="InvAuto.Features.SheetMetal.MarkingSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:InvAuto.Framework.Ui"
        Title="Маркировка"
        Width="900" Height="540" MinWidth="760" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBrush}"
        FontFamily="Segoe UI" FontSize="12"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/InvAuto;component/Framework/Ui/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="FieldLabel" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            </Style>
            <Style x:Key="Unit" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="6,0,0,0" />
            </Style>
            <Style x:Key="Field" TargetType="Grid">
                <Setter Property="Margin" Value="0,0,0,8" />
            </Style>
            <Style x:Key="Number" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                <Setter Property="Width" Value="80" />
                <Setter Property="Height" Value="24" />
                <Setter Property="HorizontalContentAlignment" Value="Right" />
                <Setter Property="HorizontalAlignment" Value="Left" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel>
        <!-- Кнопки -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource StatusBar}" Padding="12,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource DialogButton}" IsDefault="True" Click="OnOk">ОК</Button>
                    <Button Style="{StaticResource DialogButton}" IsCancel="True">Отмена</Button>
                </StackPanel>
                <TextBlock x:Name="ErrorText" Foreground="{StaticResource ErrorBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
            </DockPanel>
        </Border>

        <!-- Заголовок: кого касается -->
        <Border DockPanel.Dock="Top" Style="{StaticResource PanelHeader}" Padding="16,10">
            <StackPanel>
                <TextBlock x:Name="ScopeTitle" FontWeight="SemiBold" FontSize="13" />
                <TextBlock x:Name="ScopeText" Style="{StaticResource MutedText}" Margin="0,2,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ===== Параметры ===== -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16,14,16,14" Grid.IsSharedSizeScope="True">
                    <CheckBox x:Name="UseDefaultBox" Margin="0,0,0,14" Checked="OnChanged" Unchecked="OnChanged" />

                    <StackPanel x:Name="OptionsPanel">
                        <TextBlock Text="Параметры" Style="{StaticResource SectionTitle}" />
                        <CheckBox x:Name="EnabledBox" Content="Наносить обозначение детали" Margin="0,0,0,6"
                                  Checked="OnChanged" Unchecked="OnChanged" />
                        <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,12"
                                   Text="Текст (TEXT) на отдельном слое DXF — для гравировки. Место подбирается автоматически: ближе к центру детали, с отступом от контура, отверстий и линий гиба." />

                        <StackPanel x:Name="FieldsPanel">
                            <Grid Style="{StaticResource Field}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Высота текста" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="HeightBox" Grid.Column="2" Style="{StaticResource Number}" TextChanged="OnChanged" />
                                <TextBlock Grid.Column="3" Text="мм" Style="{StaticResource Unit}" />
                            </Grid>
                            <Grid Style="{StaticResource Field}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Если не помещается — до" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="MinHeightBox" Grid.Column="2" Style="{StaticResource Number}" TextChanged="OnChanged"
                                         ToolTip="Наименьшая высота текста. Равна высоте — не уменьшать." />
                                <TextBlock Grid.Column="3" Text="мм" Style="{StaticResource Unit}" />
                            </Grid>
                            <Grid Style="{StaticResource Field}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Отступ от контуров" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="MarginBox" Grid.Column="2" Style="{StaticResource Number}" TextChanged="OnChanged"
                                         ToolTip="Наименьшее расстояние от текста до контура, отверстий и линий гиба" />
                                <TextBlock Grid.Column="3" Text="мм" Style="{StaticResource Unit}" />
                            </Grid>
                            <Grid Style="{StaticResource Field}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Слой DXF" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="LayerBox" Grid.Column="2" Height="24" Width="160" HorizontalAlignment="Left"
                                         TextChanged="OnChanged" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Column="1" Width="1" Background="{StaticResource BorderBrush}" />

            <!-- ===== Развертка с маркировкой ===== -->
            <DockPanel Grid.Column="2" Margin="16,14,16,10">
                <TextBlock DockPanel.Dock="Top" Text="Развертка" Style="{StaticResource SectionTitle}" />
                <TextBlock x:Name="SampleTitle" DockPanel.Dock="Top" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,8" />
                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="{StaticResource WindowBrush}">
                    <ui:FlatPatternView x:Name="Preview" Margin="14"
                                        ProfileBrush="{StaticResource FlatProfileBrush}"
                                        BendBrush="{StaticResource FlatBendBrush}"
                                        AuxiliaryBrush="{StaticResource FlatAuxBrush}" />
                </Border>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
