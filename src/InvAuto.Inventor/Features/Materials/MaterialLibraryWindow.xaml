<Window x:Class="InvAuto.Features.Materials.MaterialLibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Библиотека материалов"
        Width="780" Height="560" MinWidth="620" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBrush}"
        FontFamily="Segoe UI" FontSize="12"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/InvAuto;component/Framework/Ui/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="ListButton" TargetType="Button" BasedOn="{StaticResource DialogButton}">
                <Setter Property="Margin" Value="0,0,6,0" />
                <Setter Property="MinWidth" Value="0" />
            </Style>

            <DataTemplate x:Key="DefaultCell">
                <CheckBox IsChecked="{Binding IsDefault, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"
                          VerticalAlignment="Center" Focusable="False"
                          ToolTip="Материал по умолчанию для своей толщины: его получают детали без назначенного вручную материала" />
            </DataTemplate>

            <Style x:Key="ErrorRow" TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                <Setter Property="ToolTip" Value="{x:Null}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding HasError}" Value="True">
                        <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                        <Setter Property="ToolTip" Value="{Binding Error}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel>
        <!-- Кнопки -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource StatusBar}" Padding="12,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource DialogButton}" IsDefault="True" Click="OnOk">ОК</Button>
                    <Button Style="{StaticResource DialogButton}" IsCancel="True">Отмена</Button>
                </StackPanel>
                <Button DockPanel.Dock="Left" Style="{StaticResource LinkButton}" VerticalAlignment="Center" Click="OnOpenFolder"
                        ToolTip="Открыть папку библиотеки (там же — резервные копии)">Папка библиотеки</Button>
                <TextBlock x:Name="ErrorText" Foreground="{StaticResource ErrorBrush}" VerticalAlignment="Center"
                           TextWrapping="Wrap" Margin="12,0" />
            </DockPanel>
        </Border>

        <!-- Пояснение -->
        <Border DockPanel.Dock="Top" Style="{StaticResource PanelHeader}" Padding="16,10">
            <StackPanel>
                <TextBlock Text="Материалы листа" FontWeight="SemiBold" FontSize="13" />
                <TextBlock Style="{StaticResource Hint}">
                    Материал, отмеченный «по умолчанию», получают все детали этой толщины, которым материал не назначен вручную.
                    Плотность нужна для расчёта массы. Библиотека хранится отдельно от настроек и кэша и автоматически
                    не очищается; при каждом сохранении прежняя версия копируется в папку backup.
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Действия со списком -->
        <DockPanel DockPanel.Dock="Top" Margin="16,12,16,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Style="{StaticResource ListButton}" Click="OnImport"
                        ToolTip="Добавить материалы из файла (XML или CSV). Совпадающие по наименованию и толщине обновят плотность; ничего не удаляется.">Импорт…</Button>
                <Button Style="{StaticResource ListButton}" Margin="0" Click="OnExport"
                        ToolTip="Сохранить библиотеку в файл: CSV — таблица для Excel, XML — полная копия для переноса на другой компьютер">Экспорт…</Button>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource ListButton}" Click="OnAdd" ToolTip="Новый материал (Insert)">Добавить</Button>
                <Button Style="{StaticResource ListButton}" Click="OnDuplicate" ToolTip="Копия выделенного материала — например, той же марки другой толщины">Дублировать</Button>
                <Button Style="{StaticResource DangerButton}" Margin="0" Click="OnDelete" ToolTip="Удалить выделенные материалы (Delete)">Удалить</Button>
            </StackPanel>
        </DockPanel>

        <Border Margin="16,0,16,12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <DataGrid x:Name="MaterialsGrid" SelectionMode="Extended" CanUserReorderColumns="False" RowHeight="26"
                      RowStyle="{StaticResource ErrorRow}" PreviewKeyDown="OnGridKeyDown">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="По умолч." Width="72" CellTemplate="{StaticResource DefaultCell}"
                                            SortMemberPath="IsDefault" />
                    <DataGridTextColumn Header="Наименование (марка, стандарт)" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                    <DataGridTextColumn Header="Толщина, мм" Binding="{Binding ThicknessText, UpdateSourceTrigger=PropertyChanged}" Width="110"
                                        SortMemberPath="Thickness" />
                    <DataGridTextColumn Header="Плотность, кг/м³" Binding="{Binding DensityText, UpdateSourceTrigger=PropertyChanged}" Width="130"
                                        SortMemberPath="Density" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</Window>
